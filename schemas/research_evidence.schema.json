{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "title",
    "published_at",
    "evidence_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_status": {
      "enum": [
        "reported",
        "corroborated",
        "verified",
        "disputed",
        "superseded"
      ]
    },
    "related_indicator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "fetched_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
