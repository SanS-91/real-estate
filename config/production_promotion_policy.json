    "indicator_id",
    "period_type",
    "period"
  ],
  "conflict_rule": "fail-on-existing-logical-key-change",
  "record_drop_rule": "forbid",
  "atomic_write": true,
  "rollback_snapshot": true,
  "max_snapshots": 10,
  "notes": [
    "Phase 4.2I.3 expands the controlled production allowlist to verified official NSO banking-liquidity observations.",
    "CPI, credit growth, and bank funding require ready-canonical + verified NSO evidence.",
    "FX and Gold continue to require ready-corroborated + at least two independent agreeing sources.",
    "Repository persistence remains a separate manual gate; no scheduled collector can push to main."
  ]
