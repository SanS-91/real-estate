{
  "schema_version": 2,
  "mode": "controlled-production-v1",
  "production_write": true,
  "repository_publish": false,
  "frontend_publish": false,
  "allowed_readiness_statuses": [
    "ready-canonical",
    "ready-corroborated"
  ],
  "allowed_indicators": {
    "cpi-yoy": {
      "allowed_sources": [
        "nso-vietnam"
      ],
      "required_readiness_statuses": [
        "ready-canonical"
      ],
      "required_evidence_status": "verified",
      "required_period_type": "month"
    },
    "cpi-mom": {
      "allowed_sources": [
        "nso-vietnam"
      ],
      "required_readiness_statuses": [
        "ready-canonical"
      ],
      "required_evidence_status": "verified",
      "required_period_type": "month"
    },
    "core-cpi-yoy": {
      "allowed_sources": [
        "nso-vietnam"
      ],
      "required_readiness_statuses": [
        "ready-canonical"
      ],
      "required_evidence_status": "verified",
      "required_period_type": "month"
    },
