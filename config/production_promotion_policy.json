        "ready-corroborated"
      ],
      "required_evidence_status": "corroborated",
      "required_period_type": "day",
      "required_min_independent_sources": 2
    },
    "credit-growth-ytd": {
      "allowed_sources": [
        "nso-vietnam"
      ],
      "required_readiness_statuses": [
        "ready-canonical"
      ],
      "required_evidence_status": "verified",
      "required_period_type": "month"
    },
    "bank-funding-growth-ytd": {
      "allowed_sources": [
